# 複製為 web/.env.local。正式環境請在 Cloudflare Pages / Worker 建置時注入。

# LINE LIFF ID（公開識別碼，仍請依環境分開設定）
VITE_LIFF_ID=your-liff-id

# 本機由 Vite proxy 轉到 Worker，可留空。若前後端不同網域再填完整 API origin。
VITE_API_BASE_URL=

# 本機沒有 LIFF 時使用開發身分（正式環境請勿設為 true）
VITE_DEV_AUTH=true
VITE_DEV_USER_ID=U-dev
VITE_DEV_DISPLAY_NAME=開發者
# 本機開發群組 ID（僅供 /api/dev/context 簽發 context token；正式環境不使用）
VITE_DEV_GROUP_ID=G-dev
