{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/vitest-pool-workers"]
  },
  "include": ["worker/src/**/*.ts", "worker/test/**/*.ts", "shared/**/*.ts", "worker/env.d.ts"],
  "exclude": ["node_modules", "web", "dist", "dist-worker"]
}
