{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "worker/src/**/*.ts",
    "shared/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": ["node_modules", "web", "dist", "dist-worker", "worker/test"]
}
