{
  "name": "joyin",
  "version": "1.0.0",
  "private": true,
  "description": "JoyIn — LINE 群組活動報名系統",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:worker": "wrangler dev",
    "build": "npm run build:web",
    "build:web": "VITE_DEV_AUTH=false vite build --config web/vite.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "typecheck": "wrangler types >/dev/null && tsc -p web/tsconfig.json && tsc -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply joyin-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply joyin-db --remote",
    "db:create": "wrangler d1 create joyin-db",
    "types:worker": "wrangler types",
    "deploy": "npm run build:web && wrangler deploy",
    "deploy:pages": "npm run build:web && wrangler pages deploy web/dist --project-name joyin-web",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@line/liff": "^2.27.2",
    "hono": "^4.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.71",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
